{
  "options": {
    "palette": {
      "values": [
        "default",
        "mono"
      ],
      "default": "default",
      "scope": "Inherited; applies to supported targets",
      "affects": "Coordinated page, surface, foreground, border, link and primary colours. Light/dark follows data-theme. Success, warning and error colours stay semantic."
    },
    "theme": {
      "values": [
        "auto",
        "light",
        "dark"
      ],
      "default": "auto",
      "scope": "Inherited; applies to supported targets",
      "affects": "Page and component colour scheme: auto follows the visitor's preference."
    },
    "accent": {
      "values": [
        "blue",
        "violet",
        "teal",
        "green",
        "orange",
        "rose"
      ],
      "default": "Palette primary",
      "scope": "Inherited; applies to supported targets",
      "affects": "Primary actions, badges, alerts, native accent controls and checked switches. Links retain their theme colour. Explicit accents reset their foreground; omitted accents follow data-palette."
    },
    "shape": {
      "values": [
        "square",
        "subtle",
        "rounded",
        "pill"
      ],
      "default": "rounded",
      "scope": "Inherited; applies to supported targets",
      "affects": "Styled controls, surfaces, navigation, media, code, choice labels, avatars and placeholders."
    },
    "fill": {
      "values": [
        "gradient",
        "solid"
      ],
      "default": "gradient",
      "scope": "Inherited; applies to supported targets",
      "affects": "Button, badge and alert gradients; optional glass sheen. Does not change material."
    },
    "density": {
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "default": "comfortable",
      "scope": "Inherited; applies to supported targets",
      "affects": "Control and surface padding, list and description spacing, card sections and layout spacing."
    },
    "depth": {
      "values": [
        "flat",
        "subtle",
        "pronounced"
      ],
      "default": "subtle",
      "scope": "Inherited; applies to supported targets",
      "affects": "Action and surface shadows. Text-control inset shadows are configured with data-controls."
    },
    "motion": {
      "values": [
        "none",
        "subtle",
        "expressive"
      ],
      "default": "subtle",
      "scope": "Inherited; applies to supported targets",
      "affects": "Action transitions, accordion expansion and chevron rotation (expressive adds a fade), press movement, decorative edges, custom spinners, switch transitions and skeleton shimmer. Reduced motion wins; native progress is browser-owned."
    },
    "type": {
      "values": [
        "compact",
        "standard",
        "large"
      ],
      "default": "standard",
      "scope": "Inherited; applies to supported targets",
      "affects": "Page or subtree typography."
    },
    "border": {
      "values": [
        "subtle",
        "defined",
        "none"
      ],
      "default": "subtle",
      "scope": "Inherited; applies to supported targets",
      "affects": "Styled control and surface borders, table rules and navigation boundaries. Invalid-state and forced-colour boundaries take priority."
    },
    "contrast": {
      "values": [
        "auto",
        "more"
      ],
      "default": "auto",
      "scope": "Inherited; applies to supported targets",
      "affects": "Foreground and boundary contrast; optional glass becomes opaque. System preferences retain their component-specific priority."
    },
    "tone": {
      "values": [
        "neutral",
        "cool",
        "warm"
      ],
      "default": "Palette surfaces",
      "scope": "Inherited; applies to supported targets",
      "affects": "Override page and surface temperature without resetting the palette accent, links or foregrounds."
    },
    "controls": {
      "values": [
        "styled",
        "minimal"
      ],
      "default": "styled",
      "scope": "Inherited; applies to supported targets",
      "affects": "Text input, select and textarea backing and inset shadow."
    },
    "width": {
      "values": [
        "narrow",
        "standard",
        "wide"
      ],
      "default": "standard",
      "scope": "Inherited; applies to supported targets",
      "affects": "Maximum width of .container."
    },
    "table": {
      "values": [
        "plain",
        "striped",
        "bordered"
      ],
      "default": "plain",
      "scope": "Inherited; applies to supported targets",
      "affects": "Table stripes and grid lines; rule thickness follows data-border."
    },
    "size": {
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "scope": "Inherited; applies to supported targets",
      "affects": "Controls, menu actions, badges, alerts, accordion summaries, breadcrumbs, pagination, form labels, choice labels, spinners and avatars."
    },
    "ratio": {
      "values": [
        "auto",
        "square",
        "landscape",
        "portrait",
        "wide"
      ],
      "default": "auto",
      "scope": "Inherited; applies to supported targets",
      "affects": "Image and video aspect ratio; auto retains natural proportions."
    },
    "fit": {
      "values": [
        "cover",
        "contain"
      ],
      "default": "cover",
      "scope": "Inherited; applies to supported targets",
      "affects": "Image, video and avatar content within constrained dimensions."
    },
    "gap": {
      "values": [
        "none",
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "scope": "Inherited; applies to supported targets",
      "affects": "Spacing in .grid, .row, .stack, .accordion, .pagination, .tabs and .toolbar; combines with density."
    },
    "material": {
      "values": [
        "solid",
        "glass",
        "veil",
        "soft"
      ],
      "default": "solid",
      "scope": "Inherited; applies to supported targets",
      "affects": "Solid surfaces by default; optional Glass or Soft UI surfaces and actions use their matching extension. Veil is deprecated and retained for existing sites. Explicit material boundaries stop another inherited material.",
      "deprecatedValues": {
        "veil": "Deprecated; retained for existing sites. Use solid, glass or soft for new interfaces."
      }
    },
    "edge": {
      "values": [
        "plain",
        "gradient",
        "shine",
        "animated"
      ],
      "default": "plain",
      "scope": "Inherited; applies to supported targets",
      "affects": "Decorative borders on buttons, .button links and cards. Shine sweeps on interaction; animated turns continuously. Native action inputs keep regular borders."
    },
    "variant": {
      "values": [
        "primary",
        "success",
        "warning",
        "danger",
        "neutral"
      ],
      "default": "primary",
      "scope": "Inherited; applies to supported targets",
      "affects": "Button, action-input, .button link, badge and alert semantic colour. Primary uses the inherited accent; local legacy button classes override inherited variants, while a valid action-level attribute takes precedence."
    },
    "appearance": {
      "values": [
        "tinted",
        "solid",
        "outline"
      ],
      "default": "tinted",
      "scope": "Inherited; applies to supported targets",
      "affects": "Badge and alert backing and border treatment. Does not configure buttons."
    },
    "navbar": {
      "values": [
        "standard",
        "centered",
        "floating",
        "split"
      ],
      "default": "standard",
      "scope": "Inherited; applies to .top-menu only",
      "affects": "Top navigation layout: standard brand and links, centered links, inset floating surface, or central brand with links on either side. Mobile retains the shared Menu button and popovers. Does not change sidebars."
    },
    "navbar-position": {
      "values": [
        "static",
        "sticky"
      ],
      "default": "static",
      "scope": "Inherited; applies to .navbar-header, standalone .top-menu and .app-shell > header",
      "affects": "Static follows normal document flow. Sticky keeps the outer header at block-start of its scroll container; layout, palette and material remain independent. Put the wrapper in the scrolling page, outside short sections."
    },
    "navbar-spacing": {
      "values": [
        "flush",
        "spaced"
      ],
      "default": "spaced",
      "scope": "Inherited; applies to .navbar-header and standalone .top-menu",
      "affects": "Flush removes the wrapper gap and Floating margins so a sticky bar meets the safe top edge. Spaced adds wrapper breathing room, reduced on small screens, and retains Floating margins."
    },
    "navbar-width": {
      "values": [
        "contained",
        "full"
      ],
      "default": "contained",
      "scope": "Inherited; applies to .navbar-header and .top-menu",
      "affects": "Contained follows the shared page width and navbar layout. Full fills its parent with a navbar surface while aligning its contents to the shared page width. Use a page-wide wrapper to reach both screen edges; app-shell toolbars retain their grid column."
    },
    "button-material": {
      "values": [
        "default",
        "solid",
        "glass",
        "veil",
        "soft",
        "liquid"
      ],
      "default": "default",
      "scope": "Inherited; native button/submit/reset actions and .button/.scroll-top links, excluding navigation toggles and dropdown controls",
      "affects": "Optional button material extension. Default follows data-material at the action; explicit choices override general material for actions only. Liquid is transparent neutral glass without accent tint; movement follows data-motion. Veil is deprecated and retained for existing sites.",
      "deprecatedValues": {
        "veil": "Deprecated; retained for existing sites. Use solid, glass or soft for new interfaces."
      }
    }
  },
