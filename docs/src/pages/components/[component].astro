---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Example from '../../components/Example.astro';
import { topics } from '../../data/examples.js';
import { componentContracts } from '../../data/documentation.js';
export function getStaticPaths() { return topics.map(topic=>({params:{component:topic.slug},props:{topic}})); }
const { topic }=Astro.props;
const api=componentContracts[topic.slug];
const base=import.meta.env.BASE_URL;
const sections=[{id:'usage',title:'Usage'},...topic.examples];
---
<DocsLayout title={topic.title} active={topic.slug} sections={sections}>

<p class="doc-kicker">COMPONENTS</p><h1>{topic.title}</h1><p class="doc-lead">{topic.intro}</p>
<section id="usage">
<h2>Usage</h2>
<p><strong>Markup:</strong> <code>{api[0]}</code></p>
<p><strong>Behaviour:</strong> {api[3]}</p>
{topic.notes?.length>0 && <ul class="doc-summary">{topic.notes.map(note=><li>{note}</li>)}</ul>}
<p><a href={base+'reference/components/#'+topic.slug}>Component API and styling module</a> · <a href={base+'guide/styling/'}>Inherited appearance settings</a></p>
</section>
{topic.examples.map(example=><Example {...example} html={example.html.replaceAll('__BASE__',base)}/>)}
</DocsLayout>
