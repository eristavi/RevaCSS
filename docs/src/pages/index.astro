---
import Layout from '../layouts/Layout.astro';
import Example from '../components/Example.astro';
import { topics } from '../data/examples.js';
import { componentGroups } from '../data/documentation.js';
const base=import.meta.env.BASE_URL;
---
<Layout title="Documentation">
<p class="doc-kicker">REVACSS / DOCUMENTATION</p>
<h1>Start with HTML.<br/>Set your defaults once.</h1>
<p class="doc-lead">Style native elements, choose a shared theme on the page, and add a component class only where a pattern needs one.</p>
<div class="row"><a class="button" href={base+'guide/'}>Get started</a><a class="button outline" href={base+'reference/'}>API reference</a></div>
<div class="grid doc-summary">
<article class="card"><h2>Learn the model</h2><p>Understand inheritance, local overrides, global and scoped builds.</p><a href={base+'guide/styling/'}>Styling and inheritance</a></article>
<article class="card"><h2>Choose a theme</h2><p>Light, dark or system colours; optional glass material is a separate choice.</p><a href={base+'themes/'}>Theme guides</a></article>
<article class="card"><h2>Use the reference</h2><p>Find supported attributes, classes, CSS files and custom properties.</p><a href={base+'reference/components/'}>Component API</a></article>
</div>
<Example id="first-component" title="Page defaults, simple markup" description="The section stands in for page-level settings. The button and card inherit them without repeated attributes." html={'<section data-theme="light" data-accent="teal" data-shape="rounded">\n  <article class="card">\n    <h3>Your project</h3>\n    <p>Useful defaults for ordinary HTML.</p>\n    <a class="button" href="'+base+'guide/">Read the guide</a>\n  </article>\n</section>'}/>
<h2>Find a component</h2>
<div class="grid">{componentGroups.map(group=><section class="card"><h3>{group.title}</h3><ul>{group.slugs.map(slug=><li><a href={base+'components/'+slug+'/'}>{slug==='top-menu'?'Top menu':topics.find(t=>t.slug===slug).title}</a></li>)}</ul></section>)}</div>
<h2>Assets and full-page examples</h2>
<article class="card doc-summary"><h3>A complete marketing website</h3><p>Explore Forma: a responsive website with navigation, features, product tabs, pricing, FAQ and a contact form. Customize its parent theme, palette, material and shape, then download the matching HTML.</p><a class="button" href={base+'demos/marketing/'}>Explore the marketing demo</a></article>
<article class="card doc-summary"><h3>A complete workspace dashboard</h3><p>Explore metrics, SVG charts, project progress and activity. Customize the appearance and download native HTML with no JavaScript required.</p><a class="button" href={base+'demos/dashboard/'}>Explore the dashboard demo</a></article>
<p><a href={base+'icons/'}>SVG icon gallery</a> · <a href={base+'preview/light/'}>Light foundation</a> · <a href={base+'preview/dark/'}>Dark foundation</a> · <a href={base+'preview/glass/dark/'}>Glass page</a> · <a href={base+'plain/'}>Plain HTML comparison</a></p>
<p class="doc-note">Development preview. Documentation describes the current implementation; recent components have not yet completed release validation. npm publication remains on hold.</p>
</Layout>
