---
import Layout from '../layouts/Layout.astro';
import Example from '../components/Example.astro';
import DemoGallery from '../components/DemoGallery.astro';
import ReleaseStatus from '../components/ReleaseStatus.astro';
import {topics} from '../data/examples.js';
import {componentGroups} from '../data/documentation.js';
import {version,development} from '../data/release.js';
const base=import.meta.env.BASE_URL;
---
<Layout title="HTML-first CSS framework" description="Build with native HTML and a zero-JavaScript CSS core. Explore RevaCSS themes, components and complete website demos, with no build step required.">
  <header class="doc-hero">
    <p class="doc-kicker">REVACSS / {development ? 'DEVELOPMENT' : `VERSION ${version}`}</p>
    <h1>Start with HTML.<br/>Set your defaults once.</h1>
    <p class="doc-lead">An HTML/CSS-first framework for native elements and reusable components. Choose your theme with data attributes, then build with a zero-JavaScript core and no CSS build step.</p>
    <div class="row"><a class="button" href={base+'guide/'}>Get started</a><a class="button outline" href={base+'demos/'}>Explore demos</a><a href="https://github.com/eristavi/RevaCSS">View on GitHub</a></div>
    <ul class="doc-benefits" aria-label="Framework features"><li>Native HTML interactions</li><li>Shared design tokens</li><li>Light, dark and system themes</li><li>MIT licensed</li></ul>
  </header>
  <section class="doc-section" aria-labelledby="website-demos"><div class="doc-section-heading"><div><p class="doc-kicker">COMPLETE WEBSITES</p><h2 id="website-demos">See what you can build.</h2></div><a href={base+'demos/'}>Browse all demos</a></div><p class="doc-lead">Explore a real page layout, customize its appearance and take the HTML into your own project.</p><DemoGallery/></section>
  <section class="doc-section" aria-labelledby="learn-model"><h2 id="learn-model">A small API. Shared defaults.</h2><div class="grid doc-summary">
    <article class="card"><h3>Start with native elements</h3><p>Style meaningful HTML and add component classes where a pattern needs one.</p><a href={base+'guide/'}>Create your first page</a></article>
    <article class="card"><h3>Configure the parent</h3><p>Set colours, material, shape and spacing once. Add local overrides for exceptions.</p><a href={base+'guide/styling/'}>Styling and inheritance</a></article>
    <article class="card"><h3>Choose your finish</h3><p>Explore colour palettes, surface materials and independent button materials.</p><a href={base+'themes/'}>Theme guides</a></article>
  </div></section>
  <Example id="first-component" title="Page defaults, simple markup" description="The card and button inherit this page’s defaults. Open Customize to see both update, then use local attributes only when you need an exception." html={'<section>\n  <article class="card">\n    <h3>Your project</h3>\n    <p>Useful defaults for ordinary HTML.</p>\n    <a class="button" href="'+base+'guide/">Read the guide</a>\n  </article>\n</section>'}/>
  <section class="doc-section" aria-labelledby="find-component"><div class="doc-section-heading"><h2 id="find-component">Find a component</h2><a href={base+'reference/components/'}>Component API</a></div><div class="grid">{componentGroups.map(group=><section class="card"><h3>{group.title}</h3><ul>{group.slugs.map(slug=><li><a href={base+'components/'+slug+'/'}>{slug==='top-menu'?'Top menu':topics.find(t=>t.slug===slug).title}</a></li>)}</ul></section>)}</div></section>
  <section class="doc-section"><h2>Explore the foundations</h2><div class="row doc-resource-links"><a href={base+'icons/'}>SVG icons</a><a href={base+'preview/light/'}>Light foundation</a><a href={base+'preview/dark/'}>Dark foundation</a><a href={base+'preview/glass/dark/'}>Glass preview</a><a href={base+'plain/'}>Plain HTML comparison</a><a href={base+'reference/'}>API reference</a></div></section>
  <ReleaseStatus/>
</Layout>
<style>
.doc-hero { padding-block:clamp(1rem,4vw,3rem) 1rem; }
.doc-hero h1 { font-size:clamp(2.1rem,5vw,3.75rem); line-height:1.08; letter-spacing:-.045em; margin-block:1rem 1.5rem; }
.doc-hero .doc-lead { max-inline-size:58ch; margin-block-end:1.5rem; }
.doc-benefits { display:flex; flex-wrap:wrap; gap:.65rem 1.75rem; padding:0; list-style:none; margin-block:1.5rem 0; font-size:.85rem; color:var(--re-muted); }
.doc-benefits li { display:flex; align-items:center; gap:.45rem; }
.doc-benefits li::before { content:''; inline-size:.35rem; block-size:.35rem; border-radius:50%; background:var(--re-link); }
.doc-section-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.5rem 1rem; }
.doc-section-heading h2 { margin-block:.4rem; }
.doc-section-heading > a,.doc-resource-links a { display:inline-flex; align-items:center; min-block-size:2.75rem; }
</style>
