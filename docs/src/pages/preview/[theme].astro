---
import { stylesheet } from '../../data/assets.js';
import DocumentationHeader from '../../components/DocumentationHeader.astro';
export function getStaticPaths() { return ['light','dark','auto'].map(theme=>({params:{theme}})); }
const {theme}=Astro.params;
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en" data-theme={theme}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>RevaCSS {theme} reference</title><link rel="stylesheet" href={stylesheet('reva-fonts.css')}/><link rel="stylesheet" href={stylesheet('reva.css')}/><style>body{padding:1.5rem}main{max-inline-size:65rem;margin-inline:auto}section{margin-block:2rem}#variants button{margin:.25rem} .sample{margin-block:1rem}</style></head><body><a class="skip-link" href="#main">Skip to content</a><DocumentationHeader theme={theme}/><main id="main">
<header><p>REVA / FOUNDATION</p><h1>HTML, with a better starting point.</h1><p>A reference for native elements, component surfaces and independent design settings.</p></header>
<section aria-labelledby="type"><h2 id="type">Typography that stays readable</h2><p>Body text, <a href="#forms">underlined links</a>, <strong>strong emphasis</strong>, <em>italic emphasis</em>, <mark>highlighted passages</mark> and <code>inline code</code>.</p><blockquote><p>Useful defaults. Room to make it your own.</p></blockquote><ul><li>Meaningful native HTML</li><li>Consistent tokens and easy overrides</li></ul><details><summary>What is this preview?</summary><p>A foundation review. Open this disclosure using your keyboard.</p></details></section>
<section id="variants" aria-labelledby="actions"><h2 id="actions">Actions and states</h2><button type="button">Save changes</button><button type="button" class="secondary">Cancel</button><button type="button" class="danger">Delete</button><button type="button" class="warning">Review</button><button type="button" class="outline">Outline</button><button type="button" class="ghost">Ghost</button><button type="button" disabled>Unavailable</button><div class="sample row" data-fill="solid"><button type="button">Solid fill</button><button type="button" data-size="small">Small</button><button type="button" data-size="large">Large</button></div></section>
<section aria-labelledby="cards"><h2 id="cards">Composed surfaces</h2><div class="grid"><article class="card"><h3>Default card</h3><p>Cards add a surface. Articles themselves remain neutral.</p><button type="button">Continue</button></article><article class="card" data-theme="dark" data-accent="violet" data-shape="subtle"><h3>Local dark override</h3><p>This section changes appearance independently.</p><button type="button">Explore</button></article><article class="card" data-theme="light" data-tone="warm" data-shape="square"><h3>Warm and square</h3><p>Readable in a light surface, even on a dark page.</p><a href="#forms">Go to form</a></article></div></section>
<section id="forms" aria-labelledby="form-title"><h2 id="form-title">Native forms</h2><form action="#forms" method="get" class="stack"><div><label for="email">Email address</label><input id="email" name="email" type="email" required autocomplete="email" aria-describedby="email-help" placeholder="you@example.com"/><small id="email-help">Required. Enter an address where we can reach you.</small></div><div><label for="subject">Subject</label><select id="subject" name="subject"><option>General enquiry</option><option>Technical support</option></select></div><div><label for="message">Message</label><textarea id="message" name="message" placeholder="How can we help?"></textarea></div><fieldset><legend>Contact preference</legend><label><input type="radio" name="contact" value="email" checked/>Email</label><label><input type="radio" name="contact" value="phone"/>Phone</label></fieldset><label><input type="checkbox" name="updates"/>Receive project updates</label><div><label for="amount">Project size</label><input id="amount" type="range" min="0" max="100" value="40"/></div><div class="row"><button type="submit">Send enquiry</button><button type="reset" class="secondary">Reset</button></div></form></section>
<section aria-labelledby="table-title"><h2 id="table-title">Tables</h2><div class="table-scroll" role="region" aria-label="Example project releases" tabindex="0"><table data-table="striped"><caption>Static example data</caption><thead><tr><th scope="col">Release</th><th scope="col">Status</th><th scope="col">Focus</th></tr></thead><tbody><tr><th scope="row">Foundation</th><td>In review</td><td>Tokens and native HTML</td></tr><tr><th scope="row">Components</th><td>Planned</td><td>Navigation and content patterns</td></tr><tr><th scope="row">Extensions</th><td>Planned</td><td>Optional glass surfaces</td></tr></tbody></table></div></section>
<section aria-labelledby="rtl-title"><h2 id="rtl-title">Direction-aware layout</h2><article class="card" dir="rtl" lang="ar"><h3>واجهة واضحة</h3><p>نص تجريبي لاختبار اتجاه القراءة.</p></article></section>
<footer><p><a href={base+'themes/'}>Theme guides</a> · <a href={base+'guide/accessibility/'}>Behaviour and release status</a></p></footer></main></body></html>

