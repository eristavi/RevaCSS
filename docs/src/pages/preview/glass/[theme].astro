---
import SettingsHead from '../../../components/SettingsHead.astro';
import { stylesheet } from '../../../data/assets.js';
import GlassShowcase from '../../../components/GlassShowcase.astro';
export function getStaticPaths() { return ['light','dark','auto'].map(theme=>({params:{theme}})); }
const { theme } = Astro.params;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>RevaCSS glass material · {theme}</title><SettingsHead/>
  <link rel="stylesheet" href={stylesheet('reva-fonts.css')} />
  <link rel="stylesheet" href={stylesheet('reva.css')} />
  <link rel="stylesheet" href={stylesheet('reva.glass.css')} />
</head>
<body><noscript><link rel="stylesheet" href={base+'customizer.css'}/></noscript><a class="skip-link" href="#main">Skip to content</a>
  <GlassShowcase theme={theme} id="preview-glass" />
  <footer class="container"><article class="card" id="glass-outside"><h2>Outside the glass scope</h2><p>Loading the extension does not turn every component into glass. This card retains its regular opaque surface.</p></article><p><a href={base+'themes/glass/'}>Glass material guide</a> · <a href={base+'themes/'}>All themes</a></p></footer>
</body>
</html>
