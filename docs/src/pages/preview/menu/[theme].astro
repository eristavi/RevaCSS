---
import SettingsHead from '../../../components/SettingsHead.astro';
import { stylesheet } from '../../../data/assets.js';
import DocumentationHeader from '../../../components/DocumentationHeader.astro';
import TopMenu from '../../../components/TopMenu.astro';
export function getStaticPaths() { return ['light','dark','auto'].map(theme=>({params:{theme}})); }
const { theme } = Astro.params;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>RevaCSS top menu · {theme}</title><SettingsHead/>
  <link rel="stylesheet" href={stylesheet('reva-fonts.css')}/>
  <link rel="stylesheet" href={stylesheet('reva.css')}/>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <DocumentationHeader theme={theme}/>
  <main id="main" class="container">
    <TopMenu id="preview" label="Main navigation"/>
    <section class="prose" id="home">
      <p>REVA / NAVIGATION</p>
      <h1>A menu for every screen.</h1>
      <p>Open Products → Frameworks → Components to explore three levels of native HTML popovers. Resize the page to reveal the mobile hamburger menu button.</p>
      <p>Use Tab to move between controls and Enter or Space to toggle a submenu. Click or tap its label again to close it. Opening Resources closes Products.</p>
      <p>This example runs without JavaScript. Click outside to close the menu stack, or press Escape to close the deepest panel.</p>
    </section>
    <section class="card" id="overview"><h2>Your content stays in HTML</h2><p>A shared template generates desktop and mobile lists; CSS exposes one layout at a time. Nested popovers replace the parent view and include Back controls. Panels scroll when their content exceeds the viewport.</p></section>
    <section dir="rtl" lang="en"><h2>Right-to-left layout</h2><TopMenu id="rtl" label="Right-to-left example" /></section>
    <section class="prose" aria-label="Example link destinations">
      <h2 id="css">CSS foundation</h2><p>Tokens, typography and native controls.</p>
      <h2 id="navigation">Top menu</h2><p>Responsive, nested navigation.</p>
      <h2 id="forms">Forms and controls</h2><p>Native HTML inputs and controls.</p>
      <h2 id="templates">Templates</h2><p>Planned for a later milestone.</p>
      <h2 id="guide">Get started</h2><p>Link a stylesheet and write HTML.</p>
      <h2 id="reference">API reference</h2><p>CSS tokens and HTML classes.</p>
      <h2 id="contact">Contact</h2><p>Example destination for navigation testing.</p>
    </section>
  </main>
</body>
</html>
<style>
  header { padding-block: 1rem; }
  main { padding-block: 2rem; }
  main > section { margin-block-end: 2rem; }
</style>
