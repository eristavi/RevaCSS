---
import SettingsHead from '../components/SettingsHead.astro';
import { stylesheet } from '../data/assets.js';
import DocumentationHeader from '../components/DocumentationHeader.astro';
import { version, releaseName } from '../data/release.js';
const { title=Astro.props.frontmatter?.title || 'RevaCSS', theme='auto', current, fullWidth=false, customizer={} }=Astro.props;
const base=import.meta.env.BASE_URL;
const settingsKind=Astro.url.pathname.includes('/demos/')?'demo':'docs';
---
<!doctype html>
<html lang="en" data-theme={theme} data-palette="default">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="RevaCSS documentation: live component demos, HTML examples and shared data attributes."/><title>{title} · RevaCSS</title><SettingsHead kind={settingsKind}/><link rel="stylesheet" href={stylesheet('reva-fonts.css')}/><link rel="stylesheet" href={stylesheet('reva.css')}/><link rel="stylesheet" href={stylesheet('reva.motion.css')}/><link rel="stylesheet" href={stylesheet('reva.selects.css')}/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<DocumentationHeader theme={theme} current={current} customizer={customizer} kind={settingsKind}/>
<main id="main" class:list={{container:!fullWidth}}><slot/></main>
<footer class="container site-footer"><p>RevaCSS {version} · {releaseName} · MIT · Revaz Eristavi</p><p><a href="https://github.com/eristavi/RevaCSS">Source on GitHub</a> · <a href={base+'guide/accessibility/'}>Behaviour and limitations</a></p></footer>
</body></html>
<style is:global>
.doc-kicker { font-size:.75rem; font-weight:750; letter-spacing:.12em; color:var(--re-muted); }
.docs-content > h1 { margin-block-start:.4rem; }

body > .documentation-header { border-block-end: 1px solid var(--re-line); }
body > main#main { padding-block: 2rem 4rem; }
body > .site-footer { padding-block: 1.5rem; border-block-start: 1px solid var(--re-line); color: var(--re-muted); }
.doc-table { max-inline-size:100%; overflow:auto; }
.docs-content section { scroll-margin-block:1.5rem; }
.doc-lead { max-inline-size:65ch; font-size:1.1rem; }
.doc-note { padding:var(--re-space); border-inline-start:3px solid var(--re-link); background:var(--re-surface-alt); border-radius:var(--re-radius); }
.doc-summary { margin-block:1.5rem; }
.doc-summary li { margin-block:.5rem; }
</style>
