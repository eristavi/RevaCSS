---
const { title=Astro.props.frontmatter?.title || 'RevaCSS', theme='auto' }=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="RevaCSS foundation alpha: native HTML, adaptive CSS, minimal decisions."/><title>{title} · RevaCSS</title><link rel="stylesheet" href={`${base}reva/reva-fonts.css`}/><link rel="stylesheet" href={`${base}reva/reva.css`}/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="container">
  <nav class="top-menu" aria-label="Documentation">
    <a class="menu-brand" href={base}>RevaCSS</a>
    <details class="menu-collapse">
      <summary>Menu</summary>
      <ul class="menu-items">
        <li><a href={`${base}guide/`}>Guide</a></li>
        <li><a href={`${base}reference/`}>API reference</a></li>
        <li><details class="menu-dropdown" name="docs-primary"><summary>Components</summary><ul class="menu-panel"><li><a href={`${base}components/top-menu/`}>Top menu</a></li></ul></details></li>
        <li><details class="menu-dropdown" name="docs-primary"><summary>Previews</summary><ul class="menu-panel">
          <li><a href={`${base}plain/`}>Plain HTML</a></li>
          <li><details class="menu-dropdown" name="docs-previews"><summary>Foundation</summary><ul class="menu-panel"><li><a href={`${base}preview/light/`}>Light</a></li><li><a href={`${base}preview/dark/`}>Dark</a></li></ul></details></li>
          <li><details class="menu-dropdown" name="docs-previews"><summary>Top menu</summary><ul class="menu-panel"><li><a href={`${base}preview/menu/light/`}>Light menu</a></li><li><a href={`${base}preview/menu/dark/`}>Dark menu</a></li></ul></details></li>
        </ul></details></li>
      </ul>
    </details>
  </nav>
</header>
<main id="main" class="container"><slot/></main>
<footer class="container"><p>Foundation alpha · MIT · Revaz Eristavi · HTML and CSS only</p></footer>
</body></html>
<style>
header { padding-block: 1.3rem; border-block-end: 1px solid var(--re-line); }
main { padding-block: 2rem 4rem; }
footer { padding-block: 1.5rem; border-block-start: 1px solid var(--re-line); color: var(--re-muted); }
</style>
