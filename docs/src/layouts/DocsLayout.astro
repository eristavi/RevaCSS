---
import Layout from './Layout.astro';
import { topics } from '../data/examples.js';
import { componentGroups, learnLinks, themeLinks, referenceLinks } from '../data/documentation.js';
const { title, active, sections=[], theme='auto' } = Astro.props;
const base=import.meta.env.BASE_URL;
const groups=[
 {title:'Learn',items:learnLinks},
 {title:'Themes',items:themeLinks},
 ...componentGroups.map(g=>({title:g.title,items:g.slugs.map(slug=>({key:slug,title:slug==='top-menu'?'Top menu':topics.find(t=>t.slug===slug).title,path:'components/'+slug+'/'}))})),
 {title:'Reference',items:referenceLinks}
];
---
<Layout title={title} current={active} theme={theme}>
<div class="docs-shell">
<aside class="docs-sidebar">
  <nav class="docs-sidebar-desktop" aria-label="Documentation sections">
    {groups.map(group=><section class="doc-nav-group"><h2>{group.title}</h2><ul>{group.items.map(item=><li><a href={base+item.path} aria-current={item.key===active?'page':undefined}>{item.title}</a></li>)}</ul></section>)}
  </nav>
  <details class="docs-sidebar-mobile"><summary>Browse documentation</summary><nav aria-label="Documentation sections">
    {groups.map(group=><section class="doc-nav-group"><h2>{group.title}</h2><ul>{group.items.map(item=><li><a href={base+item.path} aria-current={item.key===active?'page':undefined}>{item.title}</a></li>)}</ul></section>)}
  </nav></details>
</aside>
<div class="docs-content"><slot/></div>
{sections.length>0 && <aside class="docs-toc"><nav aria-label="On this page"><h2>On this page</h2><ul>{sections.map(s=><li><a href={'#'+s.id}>{s.title}</a></li>)}</ul></nav></aside>}
</div>
</Layout>
<style>
.docs-shell { display:grid; grid-template-columns:14rem minmax(0,1fr); gap:2rem; align-items:start; }
.docs-content { min-inline-size:0; }
.docs-sidebar { position:sticky; top:1rem; max-block-size:calc(100dvh - 2rem); overflow-y:auto; padding:.25rem; }
.docs-sidebar-mobile { display:none; }
.doc-nav-group { margin-block-end:1.4rem; }
nav h2 { font-size:.75rem; margin-block:.6rem .35rem; letter-spacing:.06em; color:var(--re-muted); }
nav ul { list-style:none; padding:0; margin:0; }
nav li { margin:0; }
nav a { display:block; padding:.4rem .65rem; min-block-size:2.75rem; border-radius:.4rem; text-decoration:none; font-size:.9rem; }
nav a:hover { background:var(--re-surface-alt); text-decoration:underline; }
nav a[aria-current=page] { background:var(--re-surface-alt); color:var(--re-text); font-weight:700; border-inline-start:3px solid var(--re-link); }
.docs-toc { grid-column:2; border-block-start:1px solid var(--re-line); padding-block-start:1rem; }
@media (width >= 85rem) { .docs-shell { grid-template-columns:14rem minmax(0,1fr) 11rem; } .docs-toc { grid-column:3; grid-row:1; position:sticky; top:1rem; border:0; } }
@media (width < 60rem) { .docs-shell { grid-template-columns:minmax(0,1fr); gap:1rem; } .docs-sidebar { position:static; max-block-size:none; } .docs-sidebar-desktop { display:none; } .docs-sidebar-mobile { display:block; } .docs-toc { grid-column:1; grid-row:2; padding-block-start:0; } .docs-toc ul { display:flex; flex-wrap:wrap; } .docs-content { grid-row:3; } }
@media print { .docs-sidebar,.docs-toc { display:none; } .docs-shell { display:block; } }
</style>
