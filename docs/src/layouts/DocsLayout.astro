---
import Layout from './Layout.astro';
import { topics } from '../data/examples.js';
const { title, active, sections=[] } = Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['guide','guide/','Get started'], ...topics.map(t=>[t.slug,`components/${t.slug}/`,t.title]), ['top-menu','components/top-menu/','Top menu'], ['attributes','attributes/','Data attributes'], ['glass','themes/glass/','Glass material'], ['reference','reference/','API reference']];
---
<Layout title={title}>
<div class="docs-shell">
<aside class="docs-sidebar"><div class="docs-sidebar-desktop"><nav aria-label="Browse documentation"><p class="eyebrow">DOCUMENTATION</p><ul>{links.map(([key,url,label])=><li><a href={base+url} aria-current={key===active?'page':undefined}>{label}</a></li>)}</ul></nav></div><details class="docs-sidebar-mobile"><summary>Browse documentation</summary><nav aria-label="Browse documentation"><p class="eyebrow">DOCUMENTATION</p><ul>{links.map(([key,url,label])=><li><a href={base+url} aria-current={key===active?'page':undefined}>{label}</a></li>)}</ul></nav></details></aside>
<div class="docs-content"><slot/></div>
{sections.length>0 && <aside class="docs-toc"><div class="docs-sidebar-desktop"><nav aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ul>{sections.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul></nav></div><details class="docs-sidebar-mobile"><summary>On this page</summary><nav aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ul>{sections.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul></nav></details></aside>}
</div>
</Layout>
<style>
.docs-shell { display:grid; grid-template-columns:12rem minmax(0,1fr); gap:2.5rem; align-items:start; }
.docs-content { min-inline-size:0; } .docs-sidebar-mobile { display:none; } .docs-sidebar { position:sticky; top:1rem; max-block-size:calc(100dvh - 2rem); overflow-y:auto; padding:.5rem; }
.eyebrow { font-size:.72rem; font-weight:750; letter-spacing:.1em; color:var(--re-muted); }
ul { list-style:none; padding:0; } li+li { margin-block-start:.2rem; } nav a { display:block; padding:.5rem .65rem; border-radius:.4rem; text-decoration:none; font-size:.9rem; }
nav a:hover { background:var(--re-surface-alt); } nav a[aria-current=page] { background:var(--re-surface-alt); color:var(--re-text); font-weight:750; border-inline-start:3px solid var(--re-link); }
.docs-toc { grid-column:2; border-block-start:1px solid var(--re-line); padding-block-start:1rem; }
@media (width >= 85rem) { .docs-shell { grid-template-columns:12rem minmax(0,1fr) 10rem; gap:2rem; } .docs-toc { grid-column:3; grid-row:1; position:sticky; top:1rem; border:0; } }
@media (width < 60rem) { .docs-shell { grid-template-columns:minmax(0,1fr); gap:1.5rem; } .docs-sidebar { position:static; max-block-size:none; border-block-end:1px solid var(--re-line); } .docs-sidebar-desktop { display:none; } .docs-sidebar-mobile { display:block; margin:0; } .docs-sidebar ul { display:flex; flex-wrap:wrap; gap:.2rem; } .docs-toc { grid-column:1; grid-row:2; } .docs-content { grid-row:3; } }
</style>
