---
import TopMenuLinks from './TopMenuLinks.astro';
const { id='demo', label='Example site', current='home' } = Astro.props;
---
<nav class="top-menu" aria-label={label} style={`--re-menu-anchor: --${id}-navigation`}>
  <a class="menu-brand" href="#home">RevaCSS</a>
  <TopMenuLinks id={`${id}-desktop`} current={current} desktop />
  <button type="button" class="menu-toggle menu-collapse" popovertarget={`${id}-mobile-menu`}>Menu</button>
  <TopMenuLinks id={`${id}-mobile`} current={current} />
</nav>

