---
const { id, current='home', desktop=false } = Astro.props;
---
<ul class:list={["menu-items", {"menu-desktop": desktop, "menu-mobile": !desktop}]} id={desktop ? undefined : `${id}-menu`} popover={desktop ? undefined : 'auto'}>
  {!desktop && <li class="menu-back"><button type="button" class="menu-toggle" popovertarget={`${id}-menu`} popovertargetaction="hide" autofocus>Close menu</button></li>}
  <li><a href="#home" aria-current={current==='home' ? 'page' : undefined}>Home</a></li>
  <li class="menu-dropdown">
    <button type="button" class="menu-toggle" popovertarget={`${id}-products`}>Products</button>
    <ul class="menu-panel" id={`${id}-products`} popover="auto">
      <li class="menu-back"><button type="button" class="menu-toggle" popovertarget={`${id}-products`} popovertargetaction="hide" autofocus>Back to main menu</button></li>
      <li><a href="#overview">All products</a></li>
      <li class="menu-dropdown">
        <button type="button" class="menu-toggle" popovertarget={`${id}-frameworks`}>Frameworks</button>
        <ul class="menu-panel" id={`${id}-frameworks`} popover="auto">
          <li class="menu-back"><button type="button" class="menu-toggle" popovertarget={`${id}-frameworks`} popovertargetaction="hide" autofocus>Back to Products</button></li>
          <li><a href="#css">CSS foundation</a></li>
          <li class="menu-dropdown">
            <button type="button" class="menu-toggle" popovertarget={`${id}-components`}>Components</button>
            <ul class="menu-panel" id={`${id}-components`} popover="auto">
              <li class="menu-back"><button type="button" class="menu-toggle" popovertarget={`${id}-components`} popovertargetaction="hide" autofocus>Back to Frameworks</button></li>
              <li><a href="#navigation">Top menu</a></li>
              <li><a href="#forms">Forms and controls</a></li>
            </ul>
          </li>
        </ul>
      </li>
      <li><a href="#templates">Templates</a></li>
    </ul>
  </li>
  <li class="menu-dropdown">
    <button type="button" class="menu-toggle" popovertarget={`${id}-resources`}>Resources</button>
    <ul class="menu-panel" id={`${id}-resources`} popover="auto">
      <li class="menu-back"><button type="button" class="menu-toggle" popovertarget={`${id}-resources`} popovertargetaction="hide" autofocus>Back to main menu</button></li>
      <li><a href="#guide">Get started</a></li>
      <li><a href="#reference">API reference</a></li>
    </ul>
  </li>
  <li><a href="#contact">Contact</a></li>
</ul>
