---
import SettingsHead from '../SettingsHead.astro';
import DashboardSite from './DashboardSite.astro';
const {config,assetBase}=Astro.props;
---
<!doctype html>
<html lang="en" data-theme={config.theme} data-palette={config.palette} data-material={config.material} data-shape={config.shape}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Forma Studio · RevaCSS dashboard demo</title><SettingsHead kind="demo"/><meta name="description" content="A fictional team workspace dashboard built with native HTML, CSS and SVG."/>
{['reva-fonts.css','reva.css','reva.motion.css','reva.selects.css','reva.glass.css','reva.veil.css'].map(file=><link rel="stylesheet" href={assetBase+'reva/'+file}/>)}
<link rel="stylesheet" href={assetBase+'demos/dashboard.css'}/></head>
<body class="dash-site"><a class="skip-link" href="#dashboard-title">Skip to dashboard</a><DashboardSite base={assetBase} embedded={false}/></body>
</html>
