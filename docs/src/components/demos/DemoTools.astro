---
import DemoCustomizer from './DemoCustomizer.astro';
import catalog from '../../../../src/icons/catalog.json';
const {config,downloadHref,downloadName}=Astro.props;
const base=import.meta.env.BASE_URL;
const icon=catalog.find(item=>item.name==='arrow-left') || catalog.find(item=>item.name==='arrow-right');
---
<div class="demo-tools">
  <a class="demo-docs-link" href={base} aria-label="Back to RevaCSS documentation"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.body}/><span>Docs</span></a>
  <DemoCustomizer config={config} downloadHref={downloadHref} downloadName={downloadName} kind="demo"/>
</div>
<style>
.demo-tools { display:flex; flex-wrap:wrap; align-items:center; gap:.25rem; min-inline-size:0; }
.demo-docs-link { display:inline-flex; align-items:center; gap:.35rem; min-block-size:2.75rem; min-inline-size:2.75rem; padding:.5rem .65rem; border-radius:var(--re-radius); color:inherit; text-decoration:none; }
.demo-docs-link:hover { background:var(--re-surface-alt); }
@media (width < 40rem) { .demo-docs-link span { display:none; } }
@media print { .demo-tools { display:none; } }
</style>
