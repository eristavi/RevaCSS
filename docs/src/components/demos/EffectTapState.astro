---
// Native button activation drives declarative SVG timing; no JavaScript hooks.
// Use alphanumeric event-source IDs to avoid SMIL timing-offset ambiguity.
const {owner}=Astro.props;
---
<svg class="ef-input-state" width="1" height="1" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <set attributeName="class" to="ef-input-state ef-tapped" begin={`${owner}.click`} dur="1.6s" restart="always" fill="remove"/>
</svg>
