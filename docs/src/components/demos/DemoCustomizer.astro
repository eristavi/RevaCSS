---
import {demoOptions, defaultDemo, sourceHref} from '../../data/demo-configurations.js';
import {advancedOptions,optionLabel,customizerGroups} from '../../data/demo-settings.js';
import catalog from '../../../../src/icons/catalog.json';
const {config=defaultDemo,downloadHref,downloadName,kind='demo'}=Astro.props;
const base=import.meta.env.BASE_URL;
const controls=Object.fromEntries([...Object.entries(demoOptions).map(([key,values])=>({key,values,default:config[key],label:{theme:'Theme',palette:'Palette',material:'Material',shape:'Shape'}[key]})),...advancedOptions.map(option=>({...option,default:option.values.includes(config[option.key] ?? defaultDemo[option.key])?(config[option.key] ?? defaultDemo[option.key]):option.default}))].map(option=>[option.key,option]));
const icon=catalog.find(item=>item.name==='settings') || catalog.find(item=>item.name==='sliders') || catalog.find(item=>item.name==='menu');
const download=kind==='demo'?(downloadHref || sourceHref(base,config)):null;
---
<div class="demo-customizer">
  <button type="button" class="menu-toggle customize-toggle" popovertarget="demo-customizer-popup" aria-label="Customize">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.body}/><span>Customize</span>
  </button>
  <div id="demo-customizer-popup" class="customizer-popup" data-material="solid" data-shape="rounded" data-density="comfortable" data-size="medium" data-type="standard" data-border="subtle" data-depth="subtle" popover="auto" role="dialog" aria-labelledby="customize-title" aria-describedby="customize-description">
    <header class="customizer-header"><div><h2 id="customize-title">Customize RevaCSS</h2><p id="customize-description">Changes appear immediately. Your choices are shared across documentation and demo pages when storage is available.</p></div><button type="button" class="outline" popovertarget="demo-customizer-popup" popovertargetaction="hide" autofocus>Close</button></header>
    <div class="customizer-body">
      <form id="demo-customizer-form">
        <div class="customizer-groups">{customizerGroups.map(group=><details open={group.open} class="customizer-group"><summary>{group.title}</summary><div class="customizer-options">{group.keys.map(key=>{const option=controls[key];return <div><label for={`demo-${key}`}>{option.label}</label><select id={`demo-${key}`} name={`demo-${key}`}>{option.values.map(value=><option value={value} selected={value===option.default}>{optionLabel(value)}</option>)}</select></div>;})}</div></details>)}</div>
      </form>
      <details class="configuration-summary"><summary>View HTML configuration</summary><pre tabindex="0" role="region" aria-label="Selected page attributes"><code id="demo-configuration">{'<html lang="en"'}{Object.values(controls).map(option=>option.values.filter(value=>value!=='default').map(value=><span class={`selected-attribute attribute-${option.key}-${value}`}>{`\n  data-${option.key}="${value}"`}</span>))}{'>'}</code></pre></details>
      <p class="customizer-note">These controls use existing RevaCSS data attributes. Device accessibility preferences take priority. Escape or a click outside closes the panel.</p>
      {download && <p><a href={download} download={downloadName || `forma-${config.theme}-${config.palette}-${config.material}-${config.shape}.html`}>Download starting HTML</a></p>}
    </div>
    <footer class="customizer-footer"><div class="row"><button type="button" id="copy-configuration" disabled>Copy configuration</button><button type="reset" form="demo-customizer-form" class="outline">Reset to defaults</button></div><p id="demo-settings-status" role="status" aria-live="polite"></p></footer>
  </div>
</div>
<script is:inline>window.RevaSettings?.initCustomizer();</script>
<style>
.demo-customizer { flex:0 0 auto; }
.customize-toggle { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; inline-size:auto; min-block-size:2.75rem; }
.customizer-popup { padding:0; background:var(--re-surface); color:var(--re-text); text-align:start; font-size:1rem; line-height:1.5; }
@supports selector(:popover-open) {
 .customizer-popup { position:fixed; inset:0; margin:auto; inline-size:min(48rem,calc(100% - 2rem)); max-inline-size:calc(100% - 2rem); block-size:fit-content; max-block-size:calc(100dvh - 2rem); overflow:hidden; overscroll-behavior:contain; }
 .customizer-popup:popover-open { display:flex; flex-direction:column; }
 .customizer-popup::backdrop { background:rgb(0 0 0 / 24%); }
}
.customizer-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1rem 1.25rem; background:var(--re-surface); border-block-end:1px solid var(--re-line); flex:0 0 auto; }
.customizer-header h2 { font-size:1.2rem; margin:0; }
.customizer-header p { margin:.3rem 0 0; font-size:.85rem; color:var(--re-muted); max-inline-size:55ch; }
.customizer-header button { flex:0 0 auto; }
.customizer-body { min-block-size:0; overflow-y:auto; overscroll-behavior:contain; padding:1.25rem; }
.customizer-groups { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; align-items:start; }
.customizer-group { padding:1rem; border:1px solid var(--re-line); border-radius:var(--re-radius); margin:0; min-inline-size:0; background:var(--re-surface); }
.customizer-group summary { font-size:.95rem; font-weight:700; }
.customizer-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.85rem; padding-block-start:1rem; }
.customizer-options > div { min-inline-size:0; }
.customizer-options label { font-size:.8rem; font-weight:650; margin-block-end:.25rem; }
.customizer-options select { inline-size:100%; }
.configuration-summary { margin-block:1rem 0; background:var(--re-surface); }
.configuration-summary pre { margin-block:.8rem 0; max-inline-size:100%; white-space:pre-wrap; overflow-wrap:anywhere; background:var(--re-surface-alt); color:var(--re-text); }
.customizer-note { font-size:.8rem; color:var(--re-muted); margin-block:1rem 0; }
.customizer-footer { flex:0 0 auto; padding:.85rem 1.25rem; border-block-start:1px solid var(--re-line); background:var(--re-surface); }
.customizer-footer p { font-size:.8rem; color:var(--re-muted); margin:.4rem 0 0; }
.customizer-footer p:empty { display:none; }
.selected-attribute { display:none; }
@media (width < 40rem) { .customize-toggle span { display:none; } .customizer-groups { grid-template-columns:1fr; } .customizer-body,.customizer-header,.customizer-footer { padding:1rem; } .customizer-popup { inline-size:calc(100% - 1rem); max-inline-size:calc(100% - 1rem); max-block-size:calc(100dvh - 1rem); } }
@media (width < 23rem) { .customizer-options { grid-template-columns:1fr; } }
@media print { .demo-customizer { display:none; } }
</style>
