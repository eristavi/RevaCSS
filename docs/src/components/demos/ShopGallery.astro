---
import ShopProductArt from './ShopProductArt.astro';
const {product}=Astro.props;
const views=[{key:'overview',name:'Overview',caption:product.name},{key:'detail',name:'Detail',caption:product.material},{key:'dimensions',name:'Dimensions',caption:product.dimensions}];
---
<div class="shop-gallery">
 <p id={`gallery-${product.slug}-help`}><small>Scroll, swipe or choose a view.</small></p>
 <ul class="gallery" role="list" tabindex="0" aria-label={`${product.name} product views`} aria-describedby={`gallery-${product.slug}-help`}>
  {views.map(view=><li id={`gallery-${product.slug}-${view.key}`}><figure><ShopProductArt art={product.art} detail={view.key==='detail'} dimensions={view.key==='dimensions'}/><figcaption>{view.caption}</figcaption></figure></li>)}
 </ul>
 <nav aria-label={`${product.name} view links`} class="row">{views.map(view=><a href={`#gallery-${product.slug}-${view.key}`}>{view.name}</a>)}</nav>
</div>
