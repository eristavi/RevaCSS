---
import {customPaletteDefaults,simplePaletteKeys,paletteLabels} from '../../data/custom-palette.js';
const advancedKeys=Object.keys(customPaletteDefaults.light).filter(key=>!simplePaletteKeys.includes(key));
---
<section id="custom-palette-editor" hidden aria-labelledby="custom-palette-title">
  <h3 id="custom-palette-title">Your custom palette</h3>
  <p>Choose four foundation colours for each mode. Supporting colours are derived automatically when a foundation changes. Expand advanced colours to adjust every token.</p>
  <div class="accordion palette-modes">
    {['light','dark'].map(mode=><details class="palette-mode" open={mode==='light'}><summary>{mode==='light'?'Light mode':'Dark mode'}</summary>
      <fieldset><legend>Foundation colours</legend><div class="palette-fields">{simplePaletteKeys.map(key=><div class="palette-field"><label for={`palette-${mode}-${key}`}>{paletteLabels[key]}</label><input type="color" id={`palette-${mode}-${key}`} name={`palette-${mode}-${key}`} value={customPaletteDefaults[mode][key]}/><output for={`palette-${mode}-${key}`}>{customPaletteDefaults[mode][key]}</output></div>)}</div></fieldset>
      <div class="accordion"><details class="palette-advanced"><summary>Advanced colours</summary><fieldset><legend>Surfaces, gradients and semantic roles</legend><div class="palette-fields">{advancedKeys.map(key=><div class="palette-field"><label for={`palette-${mode}-${key}`}>{paletteLabels[key]}</label><input type="color" id={`palette-${mode}-${key}`} name={`palette-${mode}-${key}`} value={customPaletteDefaults[mode][key]}/><output for={`palette-${mode}-${key}`}>{customPaletteDefaults[mode][key]}</output></div>)}</div></fieldset></details></div>
    </details>)}
  </div>
  <div id="custom-palette-contrast" class="palette-contrast" aria-label="Palette contrast feedback"></div>
  <p class="palette-help">Contrast feedback checks solid colours in both modes; gradients and translucent materials need a visual review. Your colours stay under your control. An explicit surface tone overrides palette surfaces.</p>
  <div class="row"><button type="button" id="export-custom-palette">Export palette CSS</button><button type="button" id="copy-custom-palette" class="outline">Copy palette CSS</button></div>
  <div class="accordion"><details class="configuration-summary"><summary>View palette CSS</summary><pre tabindex="0" aria-label="Custom palette CSS"><code id="custom-palette-css"></code></pre></details></div>
  <p class="palette-help">Load your exported CSS after RevaCSS and set <code>data-palette="custom"</code> on your page or a parent. Downloaded starting HTML includes the palette.</p>
</section>
<style>
#custom-palette-editor { margin-block-start:1rem; padding:1rem; border:1px solid var(--re-line); border-radius:var(--re-radius); }
#custom-palette-editor[hidden] { display:none; }
#custom-palette-title { font-size:1.05rem; margin-block:0 .5rem; }
#custom-palette-editor > p { font-size:.85rem; }
.palette-modes { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; align-items:start; }
.palette-mode { min-inline-size:0; padding:.75rem; margin:0; }
.palette-mode summary { font-size:.9rem; font-weight:650; }
.palette-mode fieldset { padding:0; border:0; margin-block:1rem; min-inline-size:0; }
.palette-mode legend { font-size:.8rem; margin-block-end:.5rem; }
.palette-fields { display:grid; gap:.7rem; }
.palette-field { display:grid; grid-template-columns:minmax(0,1fr) 2.75rem 5rem; gap:.4rem; align-items:center; }
.palette-field label { font-size:.8rem; margin:0; }
.palette-field input[type=color] { inline-size:2.75rem; block-size:2.5rem; padding:.15rem; cursor:pointer; }
.palette-field output { font-family:monospace; font-size:.75rem; }
.palette-advanced { padding:.6rem; margin-block:1rem 0; }
.palette-contrast { font-size:.8rem; margin-block:1rem; }
.palette-contrast ul { margin:0; }
.palette-help { font-size:.8rem; color:var(--re-muted); margin-block:1rem; }
@media (width < 40rem) { .palette-modes { grid-template-columns:1fr; } }
@media (width < 23rem) { .palette-field { grid-template-columns:minmax(0,1fr) 2.75rem; } .palette-field output { grid-column:1 / -1; } }
</style>
