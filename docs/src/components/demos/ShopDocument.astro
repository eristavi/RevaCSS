---
import SettingsHead from '../SettingsHead.astro';
import ShopSite from './ShopSite.astro';
const {config,assetBase,view={kind:'catalogue'}}=Astro.props;
---
<!doctype html>
<html lang="en" data-theme={config.theme} data-palette={config.palette} data-material={config.material} data-shape={config.shape} data-navbar-position={config['navbar-position'] || 'sticky'} data-navbar-spacing={config['navbar-spacing'] || 'flush'} data-navbar-width={config['navbar-width'] || 'full'}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Still · RevaCSS shop demo</title><SettingsHead kind="demo" assetBase={new URL(assetBase).pathname}/><meta name="description" content="A fictional shop with considered objects, built with native HTML and RevaCSS."/>{['reva-fonts.css','reva.css','reva.motion.css','reva.selects.css','reva.glass.css','reva.veil.css','reva.soft.css','reva.button-materials.css'].map(file=><link rel="stylesheet" href={assetBase+'reva/'+file}/>)}<link rel="stylesheet" href={assetBase+'demos/shop.css'}/></head>
<body id="page-top" class="shop-site"><a class="skip-link" href="#shop-title">Skip to content</a><ShopSite base={assetBase} view={view} embedded={false} standalone/></body>
</html>
