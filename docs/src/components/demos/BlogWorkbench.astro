---
import {asset} from '../../data/assets.js';
import Layout from '../../layouts/Layout.astro';
import BlogSite from './BlogSite.astro';
import DemoTools from './DemoTools.astro';
import CodeViewer from '../CodeViewer.astro';
import {defaultDemo} from '../../data/demo-configurations.js';
import {blogSource} from '../../data/blog-source.js';
import {blogSourceKey} from '../../data/blog-pages.js';
const {slug,view={kind:'journal'}}=Astro.props;
const collection=view.kind!=='journal';
const title=slug?'Blog article demo':view.kind==='author'?'Blog author demo':view.kind==='archive'?'Blog archive demo':'Blog demo';
const base=import.meta.env.BASE_URL;
const source=await blogSource(defaultDemo,slug,view);
const download=base+'demos/blog/'+(slug?'source/'+slug+'.html':collection?'source/'+blogSourceKey(view)+'.html':'source.html');
---
<Layout transitions title={title} current={slug?'blog-article-demo':view.kind==='author'?'blog-author-demo':view.kind==='archive'?'blog-archive-demo':'blog-demo'} theme="auto" fullWidth customizer={{config:defaultDemo,downloadHref:download,downloadName:slug?'fieldnotes-'+slug+'.html':collection?'fieldnotes-'+view.kind+'.html':'fieldnotes-blog.html'}}>

  <link rel="stylesheet" href={asset('demos/blog.css')}/>
  <div class="demo-workbench">
    <section class="demo-preview blog-site" id="demo-site" aria-label="Fieldnotes website preview"><BlogSite base={base} slug={slug} view={view}><DemoTools slot="actions" config={defaultDemo} downloadHref={download} downloadName={slug?'fieldnotes-'+slug+'.html':collection?'fieldnotes-'+view.kind+'.html':'fieldnotes-blog.html'}/></BlogSite></section>
<div class="container"><p class="doc-kicker">REVACSS / COMPLETE WEBSITES</p><h2>{slug?'A story worth spending time with.':view.kind==='author'?'The person behind the perspectives.':view.kind==='archive'?'A collection worth exploring.':'A home for thoughtful stories.'}</h2><p class="doc-lead">{slug?'An editorial article with reading navigation, author details and related stories.':view.kind==='author'?'A dedicated author profile with a biography and published stories.':view.kind==='archive'?'Real category collections and a paginated archive using existing components.':'An independent journal with a featured story, article collection and author profile.'} Explore the shared appearance settings and download the starting HTML.</p><div class="row"><a href={base+'demos/blog/'}>Blog listing</a><a href={base+'demos/blog/room-for-better-work/'}>Full article</a><a href={base+'demos/blog/archive/'}>Archive</a><a href={base+'demos/blog/author/alex-morgan/'}>Author profile</a></div></div>
    <section class="container" aria-labelledby="blog-source-heading"><h2 id="blog-source-heading">Make this journal yours.</h2><p>Stories and authors are fictional. A CMS or backend can supply the same article markup. Story, category, author and archive links open complete examples; reading navigation uses native anchors.</p><details><summary>View complete starting HTML</summary><CodeViewer id="blog-source" code={source} highlighted={false} label="Complete blog starting HTML"/></details><p>The optional settings helper includes your current selections in the download. Without JavaScript, copy the selected attributes onto the starting document’s opening HTML tag. Download the linked CSS files and change paths when hosting your own site. Article links in downloads lead to the hosted standalone HTML examples.</p><p><a href={base+'demos/blog.css'}>blog.css</a> provides editorial composition. Cards, navigation, breadcrumbs, pagination, avatars, controls and appearance use existing RevaCSS components. Reading links follow the shared motion setting. Same-origin page links demonstrate the optional document-transition stylesheet; unsupported browsers navigate normally. The footer uses the native scroll-to-top component.</p></section>
  </div>
</Layout>
