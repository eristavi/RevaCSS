---
import TopMenu from './TopMenu.astro';
import DemoCustomizer from './demos/DemoCustomizer.astro';
import {defaultDemo} from '../data/demo-configurations.js';
import { documentationNavigation } from '../data/navigation.js';
const { theme='auto', current, customizer={}, kind='docs' }=Astro.props;
const base=import.meta.env.BASE_URL;
---
<header class="navbar-header container documentation-header">
  <TopMenu id="docs" label="Documentation" items={documentationNavigation(base)} current={current} brandHref={base}>
    <DemoCustomizer slot="actions" kind={kind} config={customizer.config || {...defaultDemo,theme}} downloadHref={customizer.downloadHref} downloadName={customizer.downloadName}/>
  </TopMenu>
</header>
<style>
.documentation-header :global(.menu-brand) { max-inline-size:none; }
</style>
