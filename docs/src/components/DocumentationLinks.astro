---
const { id, desktop=false } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<ul class:list={["menu-items", {"menu-desktop": desktop}]}>
  <li><a href={`${base}guide/`}>Guide</a></li>
  <li><a href={`${base}reference/`}>API reference</a></li>
  <li><details class="menu-dropdown" name={`${id}-primary`}><summary>Components</summary><ul class="menu-panel"><li><a href={`${base}components/top-menu/`}>Top menu</a></li></ul></details></li>
  <li><a href={`${base}themes/glass/`}>Glass material</a></li>
  <li><details class="menu-dropdown" name={`${id}-primary`}><summary>Previews</summary><ul class="menu-panel">
    <li><a href={`${base}plain/`}>Plain HTML</a></li>
    <li><details class="menu-dropdown" name={`${id}-previews`}><summary>Foundation</summary><ul class="menu-panel"><li><a href={`${base}preview/light/`}>Light</a></li><li><a href={`${base}preview/dark/`}>Dark</a></li></ul></details></li>
    <li><details class="menu-dropdown" name={`${id}-previews`}><summary>Top menu</summary><ul class="menu-panel"><li><a href={`${base}preview/menu/light/`}>Light menu</a></li><li><a href={`${base}preview/menu/dark/`}>Dark menu</a></li></ul></details></li>
    <li><details class="menu-dropdown" name={`${id}-previews`}><summary>Glass</summary><ul class="menu-panel"><li><a href={`${base}preview/glass/light/`}>Light glass</a></li><li><a href={`${base}preview/glass/dark/`}>Dark glass</a></li></ul></details></li>
  </ul></details></li>
</ul>
