{
  "name": "revacss",
  "version": "1.0.0",
  "description": "A CSS framework for native HTML. Shared design defaults, adaptive themes, and native components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eristavi/RevaCSS.git"
  },
  "bugs": {
    "url": "https://github.com/eristavi/RevaCSS/issues"
  },
  "homepage": "https://eristavi.github.io/RevaCSS/",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "tokens",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:css": "node scripts/build.mjs",
    "build:docs": "astro build --root docs",
    "build": "npm run build:css && npm run build:docs",
    "dev": "npm run build:css && astro dev --root docs --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser",
    "test:quality": "playwright test tests/browser/quality.spec.mjs",
    "check:release-quality": "node scripts/check-release-quality.mjs",
    "release:package": "python3 scripts/package-release.py"
  },
  "devDependencies": {
    "astro": "7.3.5",
    "lightningcss": "1.33.0",
    "@playwright/test": "1.63.0",
    "axe-core": "4.13.0"
  },
  "releaseName": "Erisian"
}
