{
  "name": "revacss",
  "version": "2.0.0",
  "description": "A CSS framework for native HTML. Shared design defaults, adaptive themes, and native components.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Revaz Eristavi",
    "url": "https://github.com/eristavi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eristavi/RevaCSS.git"
  },
  "bugs": {
    "url": "https://github.com/eristavi/RevaCSS/issues"
  },
  "homepage": "https://eristavi.github.io/RevaCSS/",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "main": "./dist/reva.css",
  "style": "./dist/reva.css",
  "types": "./types/index.d.ts",
  "exports": {
    "./semantic": { "types": "./types/index.d.ts", "default": "./dist/reva.semantic.css" },
    "./patterns": { "types": "./types/index.d.ts", "default": "./dist/reva.patterns.css" },
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/reva.css"
    },
    "./dist/*.css": {
      "types": "./types/index.d.ts",
      "default": "./dist/*.css"
    },
    "./dist/*": "./dist/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "unpkg": "./dist/reva.min.css",
  "jsdelivr": "./dist/reva.min.css",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "css",
    "css-framework",
    "native-html",
    "design-tokens",
    "themes",
    "responsive",
    "glass"
  ],
  "files": [
    "dist",
    "tokens",
    "types",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "NPM.md",
    "MIGRATION.md",
    "AI.md",
    "AI_MISTAKES.md",
    "AI_TROUBLESHOOTING.md",
    "CUSTOM_COMPONENTS.md",
    "VERSIONING.md",
    "QUALITY_STANDARD.md",
    "SPECIFICATION.md",
    "IMPLEMENTATION.md",
    "examples/ai-application",
    "examples/custom-components.html",
    "examples/custom-components.css",
    "examples/semantic.html",
    "examples/patterns.html",
    "quality/blockers.json",
    "RELEASE_NOTES.md",
    "quality/ai-guidance",
    "quality/releases",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:css": "node scripts/build.mjs",
    "build:docs": "node scripts/generate-ai-docs.mjs && astro build --root docs",
    "build": "npm run build:css && npm run build:docs",
    "dev": "npm run build:css && astro dev --root docs --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ai-guidance": "python3 tests/ai/evaluate.py",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser",
    "test:quality": "playwright test tests/browser/quality.spec.mjs",
    "check:release-quality": "node scripts/check-release-quality.mjs",
    "release:package": "python3 scripts/package-release.py",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build:css && npm run check:package",
    "prepublishOnly": "npm run check:release-quality -- --npm",
    "pretest:package": "npm run prepack",
    "test:package": "node --test tests/package/package.test.mjs",
    "pretest:package:browser": "npm run prepack",
    "test:package:browser": "node --test tests/package/browser.test.mjs",
    "test:astro": "node --test integrations/astro/tests/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@playwright/test": "1.63.0",
    "astro": "7.3.5",
    "axe-core": "4.13.0",
    "lightningcss": "1.33.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "releaseName": "Erisian"
}
