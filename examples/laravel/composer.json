{
    "name": "revacss/laravel-reference",
    "description": "Local reference application for the optional RevaCSS Laravel integration.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "livewire/livewire": "^3.6|^4.0",
        "revacss/laravel": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0",
        "mockery/mockery": "^1.6"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../integrations/laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "revacss/laravel": "2.0.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
