{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "types": [
      "svelte"
    ],
    "noEmit": true
  },
  "include": [
    "components/**/*.svelte"
  ]
}
