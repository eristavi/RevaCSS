{
  "name": "@revacss/svelte",
  "version": "2.0.0",
  "description": "Optional native HTML Svelte components for RevaCSS",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristavi/RevaCSS.git",
    "directory": "integrations/svelte"
  },
  "files": [
    "components",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./*.svelte": {
      "types": "./components/*.svelte",
      "svelte": "./components/*.svelte",
      "default": "./components/*.svelte"
    }
  },
  "peerDependencies": {
    "svelte": "^5.57.1",
    "revacss": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/check.mjs"
  },
  "devDependencies": {
    "svelte": "5.57.2",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
