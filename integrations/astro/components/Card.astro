---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'article'> {}
const { class: className, ...attributes } = Astro.props;
---
<article {...attributes} class:list={['card', className]}>
  {Astro.slots.has('header') && <header><slot name="header" /></header>}
  <slot />
  {Astro.slots.has('footer') && <footer><slot name="footer" /></footer>}
</article>
