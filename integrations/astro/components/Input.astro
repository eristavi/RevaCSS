---
import type { HTMLAttributes } from 'astro/types';
import Field from './Field.astro';
interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'type'> {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  type?: "text" | "email" | "password" | "search" | "tel" | "url" | "number" | "date" | "datetime-local" | "month" | "week" | "time";
}
const { id, label, hint, error, type = 'text', 'aria-describedby': externalDescription, 'aria-invalid': externalInvalid, ...attributes } = Astro.props;
if (!id?.trim() || !label?.trim()) throw new Error('Input requires a unique nonempty id and label.');
const describedBy = [externalDescription, hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
const invalid = error ? 'true' : externalInvalid;
---
<Field id={id} label={label} hint={hint} error={error}>
  <input {...attributes} id={id} type={type} aria-describedby={describedBy} aria-invalid={invalid} />
</Field>
