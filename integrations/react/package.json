{
  "name": "@revacss/react",
  "version": "2.0.0-dev.0",
  "description": "Optional native HTML React components for RevaCSS",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eristavi/RevaCSS.git",
    "directory": "integrations/react"
  },
