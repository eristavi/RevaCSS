    "check": "npm run build && node scripts/check.mjs"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "next": "16.4.0",
    "@types/node": "26.6.5"
