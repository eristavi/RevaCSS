{
    "name": "revacss/laravel",
    "description": "Optional Blade and Laravel integration for RevaCSS 2. No CSS fork or browser runtime.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": { "psr-4": { "Reva\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "Reva\\Laravel\\Tests\\": "tests/" } },
    "extra": { "laravel": { "providers": ["Reva\\Laravel\\RevaServiceProvider"] } },
    "scripts": { "test": "phpunit", "lint": "find src config tests -name '*.php' -print0 | xargs -0 -n1 php -l" },
    "config": { "sort-packages": true },
    "archive": { "exclude": ["/vendor", "/tests", "/composer.lock", "/.phpunit.cache", "/artifacts"] }
}
